<idea-plugin>
  <id>ca.aerb.codeptr-plugin</id>
  <name>Code Pointers</name>
  <vendor email="adam.l.erb@gmail.com">Adam Erb</vendor>

  <description><![CDATA[
    <p>Copy Code Pointers is an IntelliJ plugin that copies precise file references with line and column numbers to your clipboard. Great for working with AI code tools</p>

    <p><b>Example Output:</b></p>
    <ul>
      <li>Single line: <code>src/main/MyClass.java:5</code></li>
      <li>Line range: <code>src/main/MyClass.java:4-10</code></li>
      <li>With columns: <code>src/main/MyClass.java:5:10-25</code></li>
    </ul>
  ]]></description>
  <change-notes><![CDATA[

  ]]></change-notes>
  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <applicationConfigurable
      parentId="tools"
      instance="ca.aerb.codeptr.CodePointerSettingsConfigurable"
      id="ca.aerb.codeptr.settings"
      displayName="Code Pointers"
    />
  </extensions>

  <actions>
    <action
      id="CopyCodePointerAction"
      class="ca.aerb.codeptr.CopyCodePointerAction"
      text="Copy Code Pointer"
      description="Copy code pointer to clipboard"
    >
      <add-to-group group-id="EditMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="meta shift C"/>
    </action>
  </actions>
</idea-plugin>
